# NASA FIRMS key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
FIRMS_DAY_RANGE=1

# NOAA GOES-East fire product on AWS (public, no key)
GOES_BUCKET=noaa-goes19
GOES_PRODUCT=ABI-L2-FDCF
GOES_MIN_CONFIDENCE=0.5

# Monitored area: west,south,east,north (default: Brazil)
AOI_BBOX=-74.5,-34.5,-28.5,6

ENABLE_WORKER=true
POLL_INTERVAL_SECONDS=600
LIVE_RETENTION_HOURS=48

FUSION_RADIUS_KM=2
FUSION_WINDOW_HOURS=12

CORS_ORIGINS=http://localhost:5173
