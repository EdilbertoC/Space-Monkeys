# SI-assisted: written with Claude (Anthropic), reviewed by the Space Monkeys team. See README.
# NASA FIRMS key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
FIRMS_DAY_RANGE=1

# NOAA GOES-East fire product on AWS (public, no key)
GOES_BUCKET=noaa-goes19
GOES_PRODUCT=ABI-L2-FDCF
GOES_MIN_CONFIDENCE=0.5

# Monitored area: west,south,east,north (default: Brazil)
AOI_BBOX=-74.5,-34.5,-28.5,6

ENABLE_WORKER=true
POLL_INTERVAL_SECONDS=600
LIVE_RETENTION_HOURS=48

FUSION_RADIUS_KM=2
FUSION_WINDOW_HOURS=12

CORS_ORIGINS=http://localhost:5173,http://localhost:8443

# Burning activity calendar: folder written by `python -m pipeline.serving brazil`
HISTORY_DATA_DIR=data/processed/brazil/serving
HISTORY_WARM_UP=true

# Fire forecast
ENABLE_FORECAST=true
FORECAST_MODEL_DIR=models/fire_forecast_brazil
FORECAST_REFRESH_HOURS=6
FORECAST_ANCHOR_HOURS=12
